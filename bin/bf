#!/usr/bin/env sh
# Zero-dependency POSIX Brainfuck Interpreter in awk
set -eu

if [ $# -lt 1 ]; then
    echo "Usage: $0 <file.bf>" >&2
    exit 1
fi

BF_FILE="$1"

awk -v bffile="$BF_FILE" '
BEGIN {
    # Initialize ord mapping
    for (i = 0; i < 256; i++) {
        chr = sprintf("%c", i)
        ord[chr] = i
    }

    # Load and clean Brainfuck code
    code = ""
    while ((getline line < bffile) > 0) {
        code = code line
    }
    close(bffile)

    n = length(code)
    prog_len = 0
    sp = 0

    for (i = 1; i <= n; i++) {
        c = substr(code, i, 1)
        if (index("+-<>[],.", c) > 0) {
            prog_len++
            prog[prog_len] = c
            if (c == "[") {
                sp++
                stack[sp] = prog_len
            } else if (c == "]") {
                if (sp == 0) {
                    print "Error: unmatched ]" > "/dev/stderr"
                    exit 1
                }
                match_pc = stack[sp]
                sp--
                jump[match_pc] = prog_len
                jump[prog_len] = match_pc
            }
        }
    }
    if (sp > 0) {
        print "Error: unmatched [" > "/dev/stderr"
        exit 1
    }

    # VM Execution
    ptr = 0
    pc = 1
    
    # Input buffer
    in_buf = ""
    in_idx = 1
    in_eof = 0

    while (pc <= prog_len) {
        op = prog[pc]
        if (op == "+") {
            v = tape[ptr] + 1
            if (v > 255) v = 0
            tape[ptr] = v
        } else if (op == "-") {
            v = tape[ptr] - 1
            if (v < 0) v = 255
            tape[ptr] = v
        } else if (op == ">") {
            ptr++
        } else if (op == "<") {
            ptr--
            if (ptr < 0) {
                print "Error: pointer out of bounds" > "/dev/stderr"
                exit 1
            }
        } else if (op == ".") {
            printf "%c", tape[ptr]
        } else if (op == ",") {
            if (!in_eof && in_idx > length(in_buf)) {
                if ((getline line) > 0) {
                    in_buf = line "\n"
                    in_idx = 1
                } else {
                    in_eof = 1
                }
            }
            if (!in_eof && in_idx <= length(in_buf)) {
                ch = substr(in_buf, in_idx, 1)
                tape[ptr] = ord[ch]
                in_idx++
            } else {
                tape[ptr] = 0
            }
        } else if (op == "[") {
            if (!tape[ptr]) pc = jump[pc]
        } else if (op == "]") {
            if (tape[ptr]) pc = jump[pc]
        }
        pc++
    }
}
'
